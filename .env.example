# Copy to .env and fill in the values. .env is ignored by git.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=escapecenter
# Must not be "root": MySQL refuses to start with MYSQL_USER=root.
MYSQL_USER=escape
MYSQL_PASSWORD=

# The Spring server reads MYSQL_USER and MYSQL_PASSWORD too. Optional: DB_URL (defaults to localhost:3306).

# First staff login for the JavaFX app (HTTP Basic). Created in the workers table (BCrypt) on first start if missing.
# In production serve the API over HTTPS (reverse proxy), because Basic sends the password on every request.
APP_ADMIN_USER=admin
APP_ADMIN_PASSWORD=
# RabbitMQ login (broker for the booking events, management UI at http://localhost:15672). Mailpit UI: http://localhost:8025.
RABBITMQ_USER=escape
RABBITMQ_PASSWORD=
# Optional: comma-separated browser origins allowed to call the API (defaults to localhost:5173, :3000 and :80).
# CORS_ALLOWED_ORIGINS=https://escape.example.com
