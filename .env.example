# Copy to .env and fill in the values. .env is ignored by git.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=escapecenter
# Must not be "root": MySQL refuses to start with MYSQL_USER=root.
MYSQL_USER=escape
MYSQL_PASSWORD=

# The Spring server reads the same user and password under other names:
#   DB_USER = MYSQL_USER
#   DB_PASS = MYSQL_PASSWORD
