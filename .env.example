# Copy to .env and fill in the values. .env is ignored by git.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=escapecenter
# Must not be "root": MySQL refuses to start with MYSQL_USER=root.
MYSQL_USER=escape
MYSQL_PASSWORD=

# The Spring server reads MYSQL_USER and MYSQL_PASSWORD too. Optional: DB_URL (defaults to localhost:3306).

# Staff login for the JavaFX app (HTTP Basic). Temporary until staff come from the workers table (roadmap 4c).
APP_ADMIN_USER=admin
APP_ADMIN_PASSWORD=
